# ═══════════════ 1. Local development (works with everything below left empty) ═══════════════
# Copy this file to .env.local. With DATABASE_URL and SUPABASE_URL empty the app uses an embedded
# PostgreSQL stored in ./data/pgdata and a simple local login, so nothing else needs to be installed.

# Local login, created automatically the first time the app starts (local mode only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ═══════════════ 2. Supabase (database + Auth) ═══════════════
# Supabase → Connect → "Transaction pooler" connection string (port 6543); replace [YOUR-PASSWORD].
DATABASE_URL=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=               # the "anon" or "publishable" key — safe to be public
SUPABASE_SERVICE_ROLE_KEY=       # SECRET. Only used by `npm run seed` on your own computer. Do NOT add it to Vercel.

# The owner's email. The first time this email signs in (and Supabase has verified it) it is added as owner.
# Everyone else is added with: npm run seed -- someone@example.com <password> staff
ADMIN_EMAIL=

# ═══════════════ 3. Security ═══════════════
# Required on Vercel. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
SESSION_DAYS=7
# Protects the daily backup address. Required for the scheduled backup. Same generator as above.
CRON_SECRET=
# Optional: a separate key for encrypting the stored Google token (otherwise AUTH_SECRET is used)
BACKUP_ENCRYPTION_KEY=

# ═══════════════ 4. Cloudinary (student photos). Empty = photos are saved in ./data/uploads ═══════════════
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=swami-abhyasika

# ═══════════════ 5. Google Drive backups ═══════════════
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (type: Web application)
#   Authorised redirect URI: <APP_URL>/api/google/callback   (and http://localhost:3000/api/google/callback for testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public address of the app, e.g. https://swami.vercel.app (needed for the Google return address)
APP_URL=
# Which time zone decides "today" for backups
APP_TIMEZONE=Asia/Kolkata
